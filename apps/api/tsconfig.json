{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@qulify/*": ["../../packages/*/src"]
    },
    "types": ["@cloudflare/workers-types", "node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/*"],
  "exclude": ["node_modules"]
}